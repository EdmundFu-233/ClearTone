<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ClearTone.Controls"
        x:Class="ClearTone.MainWindow"
        Title="澄音 ClearTone"
        Width="1200" Height="780"
        MinWidth="980" MinHeight="640"
        Background="{DynamicResource CTBackgroundBrush}">
  <Panel>
    <Grid RowDefinitions="*,Auto">
      <Grid Grid.Row="0" ColumnDefinitions="236,*">

        <Border Grid.Column="0"
                Background="{DynamicResource CTPanelBrush}"
                BorderBrush="{DynamicResource CTDividerBrush}"
                BorderThickness="0,0,1,0">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Margin="18,20,18,10" Spacing="2">
              <TextBlock Text="澄音 ClearTone" FontSize="18" FontWeight="Bold" />
              <TextBlock Text="第三方网易云音乐" Classes="secondary" />
            </StackPanel>

            <Border DockPanel.Dock="Bottom" Margin="12" Padding="10" CornerRadius="8"
                    Background="{DynamicResource CTOverlayBrush}">
              <Button x:Name="AccountButton" Click="OnAccountClick"
                      Background="Transparent" BorderThickness="0" Padding="4"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock x:Name="AccountGlyph" Text="&#xE77B;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                             FontSize="20" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="1">
                    <TextBlock x:Name="AccountNameText" Text="未登录" FontWeight="SemiBold" />
                    <TextBlock x:Name="AccountHintText" Text="点击扫码登录" Classes="secondary" />
                  </StackPanel>
                </Grid>
              </Button>
            </Border>

            <ScrollViewer>
              <StackPanel>
                <ListBox x:Name="SidebarList" Margin="8,4,8,0"
                         SelectionChanged="OnSidebarSelectionChanged" />
                <TextBlock x:Name="PlaylistsHeader" Text="创建的歌单" Classes="secondary"
                           Margin="18,14,18,6" />
                <StackPanel x:Name="PlaylistPanel" Margin="8,0,8,16" />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*">
          <Grid Grid.Row="0" Margin="16,12,16,8" ColumnDefinitions="Auto,Auto,*,Auto">
            <Button x:Name="BackButton" Grid.Column="0" Classes="toolbar"
                    FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="16"
                    Content="&#xE72B;" IsVisible="False" Click="OnBackClick" />
            <TextBlock x:Name="PageTitleText" Grid.Column="1" Text="发现音乐"
                       FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
            <Button x:Name="SettingsButton" Grid.Column="3" Classes="toolbar"
                    FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="16"
                    Content="&#xE713;" Click="OnSettingsClick" />
          </Grid>
          <ContentControl x:Name="MainContent" Grid.Row="1" />
        </Grid>
      </Grid>

      <Border Grid.Row="1" Background="{DynamicResource CTPanelBrush}"
              BorderBrush="{DynamicResource CTDividerBrush}" BorderThickness="0,1,0,0"
              Padding="14,8">
        <Grid ColumnDefinitions="2*,3*,2*" VerticalAlignment="Center">

          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Button x:Name="ExpandButton" Click="OnExpandClick" Padding="0" BorderThickness="0"
                    Background="Transparent" ToolTip.Tip="打开正在播放">
              <controls:CoverImage x:Name="BarCover" Width="46" Height="46" CornerRadius="8"
                                   DecodeWidth="92" CoverUrl="{Binding Bar.CoverUrl}" />
            </Button>
            <Button x:Name="TitleButton" Click="OnTitleClick" Background="Transparent"
                    BorderThickness="0" Padding="4" HorizontalContentAlignment="Left"
                    ToolTip.Tip="打开正在播放">
              <StackPanel VerticalAlignment="Center" Spacing="2" MaxWidth="220">
                <TextBlock Text="{Binding Bar.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Bar.Artist}" Classes="secondary" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
            <Button x:Name="LikeButton" Click="OnLikeClick" Classes="toolbar"
                    FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="16"
                    Content="{Binding Bar.LikeGlyph}" Foreground="{Binding Bar.LikeForeground}"
                    ToolTip.Tip="喜欢" />
          </StackPanel>

          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="18">
              <Button x:Name="PrevButton" Click="OnPrevClick" Classes="toolbar"
                      FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="16"
                      Content="&#xE892;" ToolTip.Tip="上一首" />
              <Button x:Name="PlayPauseButton" Click="OnPlayPauseClick" Classes="toolbar"
                      FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="22"
                      Content="{Binding Bar.PlayPauseGlyph}" ToolTip.Tip="{Binding Bar.PlayPauseTooltip}" />
              <Button x:Name="NextButton" Click="OnNextClick" Classes="toolbar"
                      FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="16"
                      Content="&#xE893;" ToolTip.Tip="下一首" />
            </StackPanel>
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock x:Name="CurrentTimeText" Text="{Binding Bar.CurrentTimeText}"
                         Classes="secondary" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Slider x:Name="ProgressSlider" Grid.Column="1"
                      Minimum="0" Maximum="100"
                      Value="{Binding Bar.ProgressPercent, Mode=OneWay}"
                      VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding Bar.DurationText}"
                         Classes="secondary" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                      HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="SleepButton" Classes="toolbar" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="15" Content="&#xE916;" ToolTip.Tip="睡眠定时" Click="OnSleepClick" />
            <Button x:Name="ModeButton" Click="OnModeClick" Classes="toolbar"
                    FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="15"
                    Content="{Binding Bar.ModeGlyph}" ToolTip.Tip="{Binding Bar.ModeLabel}" />
            <Button x:Name="QueueButton" Click="OnQueueClick" Classes="toolbar"
                    FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="15"
                    Content="&#xE8FD;" ToolTip.Tip="播放队列" />
            <Button x:Name="RateButton" Click="OnRateClick" Classes="toolbar"
                    Content="{Binding Bar.RateLabel}" Foreground="{DynamicResource CTAccentBrush}"
                    IsVisible="{Binding Bar.IsRateAdjusted}" ToolTip.Tip="播放速度" />
            <Button x:Name="QualityButton" Click="OnQualityClick" Classes="toolbar"
                    Content="{Binding Bar.QualityLabel}" ToolTip.Tip="音质" />
            <Button x:Name="MuteButton" Click="OnMuteClick" Classes="toolbar"
                    FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="15"
                    Content="&#xE767;" ToolTip.Tip="静音" />
            <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="100"
                    Value="{Binding Bar.VolumePercent, Mode=OneWay}" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Border x:Name="NowPlayingOverlay" IsVisible="{Binding App.IsNowPlayingExpanded}"
            Background="#F20D0D12">
      <Grid RowDefinitions="Auto,*">
        <controls:AmbientBackground Grid.RowSpan="2" />
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,12">
          <Button x:Name="CollapseButton" Click="OnCollapseClick" Classes="toolbar"
                  FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="16"
                  Content="&#xE70D;" ToolTip.Tip="收起" />
          <TextBlock Grid.Column="1" Text="{Binding Bar.Title}" FontWeight="SemiBold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="正在播放" Classes="secondary" VerticalAlignment="Center" />
        </Grid>
        <ContentControl x:Name="NowPlayingHost" Grid.Row="1" />
      </Grid>
    </Border>

    <Border x:Name="QueueOverlay" IsVisible="{Binding App.ShowQueue}"
            Background="#99000000">
      <Border HorizontalAlignment="Right" Width="400"
              Background="{DynamicResource CTPanelBrush}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,14,10,8">
            <TextBlock Text="播放队列" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Click="OnQueueCloseClick" Classes="toolbar"
                    FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14"
                    Content="&#xE711;" ToolTip.Tip="关闭" />
          </Grid>
          <ContentControl x:Name="QueueHost" />
        </DockPanel>
      </Border>
    </Border>

    <Border x:Name="LoginOverlay" IsVisible="{Binding App.IsLoginPresented}"
            Background="#99000000">
      <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center"
              Background="{DynamicResource CTPanelBrush}" CornerRadius="14" Padding="24">
        <ContentControl x:Name="LoginHost" />
      </Border>
    </Border>
  </Panel>
</Window>
