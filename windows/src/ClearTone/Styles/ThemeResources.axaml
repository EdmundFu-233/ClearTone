<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="CTBackgroundBrush" Color="#111216" />
      <SolidColorBrush x:Key="CTPanelBrush" Color="#191B21" />
      <SolidColorBrush x:Key="CTOverlayBrush" Color="#22252D" />
      <SolidColorBrush x:Key="CTTextPrimaryBrush" Color="#F4F4F6" />
      <SolidColorBrush x:Key="CTTextSecondaryBrush" Color="#A6ABB7" />
      <SolidColorBrush x:Key="CTAccentBrush" Color="#EF6A67" />
      <SolidColorBrush x:Key="CTDividerBrush" Color="#2A2E38" />
      <SolidColorBrush x:Key="CTHoverBrush" Color="#2B2F3A" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="CTBackgroundBrush" Color="#F5F4F1" />
      <SolidColorBrush x:Key="CTPanelBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CTOverlayBrush" Color="#EEEEEC" />
      <SolidColorBrush x:Key="CTTextPrimaryBrush" Color="#20232A" />
      <SolidColorBrush x:Key="CTTextSecondaryBrush" Color="#626976" />
      <SolidColorBrush x:Key="CTAccentBrush" Color="#C84045" />
      <SolidColorBrush x:Key="CTDividerBrush" Color="#E2E1DE" />
      <SolidColorBrush x:Key="CTHoverBrush" Color="#E8E7E4" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
